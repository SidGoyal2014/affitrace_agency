{
    "meta": {
        "project": "Affitrace",
        "version": "3.0",
        "description": "Design system blueprint for Affitrace UI - Top Navigation Layout"
    },
    "layout": {
        "type": "top-navigation",
        "navbar": {
            "height": "64px",
            "background": "#FFFFFF",
            "shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
            "position": "sticky"
        },
        "content": {
            "max_width": "1400px",
            "padding": "2rem"
        },
        "footer": {
            "background": "#FFFFFF",
            "border_top": "1px solid #E2E8F0"
        }
    },
    "theme": {
        "colors": {
            "primary": {
                "main": "#6366F1",
                "light": "#818CF8",
                "dark": "#4F46E5",
                "contrast": "#FFFFFF"
            },
            "secondary": {
                "main": "#F472B6",
                "light": "#FBCFE8",
                "dark": "#DB2777"
            },
            "background": {
                "body": "#F8FAFC",
                "card": "#FFFFFF",
                "navbar": "#FFFFFF"
            },
            "text": {
                "primary": "#0F172A",
                "secondary": "#64748B",
                "muted": "#94A3B8",
                "navbar": "#475569",
                "navbar_active": "#6366F1"
            },
            "status": {
                "success": {
                    "main": "#10B981",
                    "light": "#D1FAE5"
                },
                "warning": {
                    "main": "#F59E0B",
                    "light": "#FEF3C7"
                },
                "error": {
                    "main": "#EF4444",
                    "light": "#FEE2E2"
                },
                "info": {
                    "main": "#3B82F6",
                    "light": "#DBEAFE"
                }
            },
            "border": {
                "light": "#E2E8F0",
                "default": "#CBD5E1"
            }
        },
        "typography": {
            "font_family": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
            "font_size": {
                "xs": "0.75rem",
                "sm": "0.875rem",
                "base": "0.9375rem",
                "lg": "1.125rem",
                "xl": "1.25rem",
                "2xl": "1.5rem",
                "3xl": "1.875rem"
            },
            "font_weight": {
                "normal": 400,
                "medium": 500,
                "semibold": 600,
                "bold": 700
            }
        },
        "spacing": {
            "xs": "0.25rem",
            "sm": "0.5rem",
            "md": "1rem",
            "lg": "1.5rem",
            "xl": "2rem",
            "2xl": "3rem"
        },
        "shadows": {
            "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
            "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1)",
            "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1)",
            "card": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
        },
        "border_radius": {
            "sm": "0.375rem",
            "md": "0.5rem",
            "lg": "0.75rem",
            "xl": "1rem",
            "full": "9999px"
        }
    },
    "components": {
        "navbar": {
            "nav_item": {
                "padding": "0.5rem 1rem",
                "font_size": "0.875rem",
                "font_weight": 500,
                "border_radius": "0.5rem"
            },
            "dropdown": {
                "min_width": "200px",
                "shadow": "$theme.shadows.lg"
            }
        },
        "card": {
            "background": "#FFFFFF",
            "border": "1px solid #E2E8F0",
            "border_radius": "0.75rem",
            "shadow": "$theme.shadows.card"
        },
        "stat_card": {
            "icon_size": "56px",
            "icon_border_radius": "0.75rem"
        },
        "button": {
            "primary": {
                "background": "#6366F1",
                "color": "#FFFFFF",
                "border_radius": "0.5rem",
                "padding": "0.625rem 1.25rem"
            }
        },
        "table": {
            "header_background": "#F8FAFC",
            "header_font_size": "0.75rem",
            "row_hover": "rgba(99, 102, 241, 0.02)"
        },
        "form_input": {
            "border": "1px solid #CBD5E1",
            "border_radius": "0.5rem",
            "padding": "0.75rem 1rem",
            "focus_ring": "0 0 0 3px rgba(99, 102, 241, 0.15)"
        }
    }
}